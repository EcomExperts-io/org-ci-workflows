<script>
  class BotDetection {
    constructor() {
      this.allTestFunctions = ['testUserAgent', 'testChromeWindow', 'testPlugins', 'testAppVersion', 'testConnectionRtt', 'testSamsungBrowser'];
    }

    testUserAgent() {
      if (/Headless/.test(window.navigator.userAgent)) {
        return 1; // Headless browser detected
      } else {
        return 0; // Standard browser
      }
    }

    testChromeWindow() {
      if (eval.toString().length == 33 && !window.chrome) {
        return 1; // Headless Chrome detected
      } else {
        return 0; // Standard Chrome or other browser
      }
    }

    testNotificationPermissions(callback) {
      if(navigator.permissions){
        navigator.permissions.query({name:'notifications'}).then(function(permissionStatus) {
          if(Notification.permission === 'denied' && permissionStatus.state === 'prompt') {
            callback(1); // Inconsistent permission state - likely headless
          } else {
            callback(0); // Consistent permission state
          }
        });
      } else {
        callback(0); // Permissions API unavailable
      }      
    }

    testPlugins() {
      let length = navigator.plugins.length;
      return length === 0 ? 1 : 0; // No plugins typically indicates headless browser
    }

    testAppVersion() {
      let appVersion = navigator.appVersion;
      return /headless/i.test(appVersion) ? 1 : 0;
    }

    testConnectionRtt() {
      let connection = navigator.connection;
      let connectionRtt = connection ? connection.rtt : undefined;

      if (connectionRtt === undefined) {
        return 0; // Connection API unavailable
      } else {
        return connectionRtt === 0 ? 1 : 0; // Zero RTT may indicate synthetic environment
      }
    }
    
    testSamsungBrowser() {
      if(navigator.userAgent.match(/SamsungBrowser/i)) {
        return 0; // Samsung Browser detected - likely genuine
      } else {
        return 1; // Non-Samsung browser
      }
    }

    getBotScore() {
      let score = 0;
      let testsRun = 0;

      this.testNotificationPermissions(function(v){
        score += v;
        testsRun++;
      });

      for(let i = 0; i < this.allTestFunctions.length; i++){
        score += this[this.allTestFunctions[i]].apply();
        testsRun++;
      }

      return score / testsRun; // Normalized bot probability score
    }
  }
  
  var botDetector = new BotDetection();
  
  // Android WebView Detection and Handling
  if(navigator.userAgent.match(/wv/i)) {
    window.botScore = 0; // WebView considered legitimate traffic
  } else {
    window.botScore = botDetector.getBotScore();
  }
</script>

